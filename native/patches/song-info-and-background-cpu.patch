+    /// Fetch article prose beyond the introduction, after verifying both title
+    /// and performer. Never replace an unknown song with an artist biography.
+    func songBackground(title: String, artist: String, refresh: Bool = false, session: URLSession = .shared) async -> MusicDescription? {
+        let key = "song-background|\(title)|\(artist)"
+        if refresh { cache.removeValue(forKey: key); cache.removeValue(forKey: "song|\(title)|\(artist)") }
+        if let (date, value) = cache[key], Date().timeIntervalSince(date) < 3600 { return value }
+        var matched = await description(title: title, artist: artist, subject: .song, session: session)
+        func request(_ fields: [String: String]) async throws -> Data {
+            var url = URLComponents(string: "https://en.wikipedia.org/w/api.php")!
+            var query = fields
+            query.merge(["action": "query", "format": "json", "formatversion": "2", "prop": "extracts|pageprops|info", "inprop": "url", "explaintext": "1", "redirects": "1"], uniquingKeysWith: { _, last in last })
+            url.queryItems = query.sorted { $0.key < $1.key }.map { .init(name: $0.key, value: $0.value) }
+            var request = URLRequest(url: url.url!, timeoutInterval: 12)
+            request.setValue("NovaMusic/1.0 (song backgrounds; Wikipedia attribution)", forHTTPHeaderField: "User-Agent")
+            let (data, response) = try await session.data(for: request)
+            guard (response as? HTTPURLResponse)?.statusCode == 200 else { throw URLError(.badServerResponse) }
+            try Task.checkCancellation()
+            return data
+        }
+        do {
+            if matched == nil {
+                let data = try await request(["generator": "search", "gsrsearch": "\(title) \(artist) song", "gsrlimit": "5", "exintro": "1"])
+                matched = Self.parse(data, title: title, artist: artist, subject: .song)
+            }
+            guard let intro = matched else { cache[key] = (Date(), nil); return nil }
+            let page = intro.source.lastPathComponent.replacingOccurrences(of: "_", with: " ")
+            let data = try await request(["titles": page, "exsectionformat": "wiki"])
+            if let full = Self.parse(data, title: title, artist: artist, subject: .song) {
+                let text = Self.songBackgroundText(full.text)
+                let result = MusicDescription(text: text.isEmpty ? intro.text : text, source: full.source, sourceName: full.sourceName)
+                cache[key] = (Date(), result)
+                return result
+            }
+            cache[key] = (Date(), intro); return intro
+        } catch { return Task.isCancelled ? nil : matched }
+    }
