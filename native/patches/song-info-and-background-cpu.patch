+    static func songBackgroundText(_ extract: String) -> String {
+        let topics = ["background", "writing", "composition", "recording", "production", "release", "reception", "music video", "performance", "legacy", "meaning", "interpretation"]
+        // Plain-text mathematical notation is not readable prose. Omit a
+        // formula-heavy section rather than displaying broken LaTeX fragments.
+        let prose = extract.components(separatedBy: "\n== ").filter { !$0.contains("\\displaystyle") && !$0.contains("\\begin{") }.joined(separator: "\n== ")
+        var include = true, lines: [String] = [], length = 0, contentEnd = 0
+        for raw in prose.components(separatedBy: .newlines) {
+            let line = raw.trimmingCharacters(in: .whitespacesAndNewlines)
+            if line.hasPrefix("==") {
+                let level = line.prefix { $0 == "=" }.count
+                let heading = line.trimmingCharacters(in: CharacterSet(charactersIn: "= "))
+                if level == 2 { include = topics.contains { heading.lowercased().contains($0) } }
+                if include && length + heading.count < 9000 { lines += ["", heading, ""]; length += heading.count + 3 }
+            } else if include && !line.isEmpty {
+                guard length + line.count + 2 <= 9000 else { break }
+                lines.append(line); lines.append(""); length += line.count + 2; contentEnd = lines.count
+            }
+        }
+        return lines.prefix(contentEnd).joined(separator: "\n").trimmingCharacters(in: .whitespacesAndNewlines)
+    }
