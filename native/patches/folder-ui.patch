+    func replaceFolderItem(_ old: MusicFolderItem, with replacement: MusicFolderItem, in id: UUID) {
+        guard old != replacement, !folder(id, contains: replacement), let index = musicFolders.firstIndex(where: { $0.id == id }) else { return }
+        let order = folderItems(id).map { $0.id == old.id ? replacement.id : $0.id }
+        switch old {
+        case .album(let album): musicFolders[index].albums.removeAll { $0.id == album.id }
+        case .playlist(let playlist): musicFolders[index].playlistIDs.removeAll { $0 == playlist }
+        }
+        switch replacement {
