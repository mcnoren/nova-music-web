+/// The SwiftUI scroll view owns the full song-list height, but UIKit only mounts
+/// a screenful of rows. A full-height embedded table otherwise creates every cell
+/// (including artwork and Combine subscriptions) before the first scroll.
+final class MusicSelectionViewport: UIView {
+    let table: MusicSelectionTableView
+    private weak var scrollHost: UIScrollView?
+    private var offsetObservation: NSKeyValueObservation?
+    private var boundsObservation: NSKeyValueObservation?
+    init(table: MusicSelectionTableView) {
+        self.table = table
+        super.init(frame: .zero)
+        clipsToBounds = true
+        table.contentInsetAdjustmentBehavior = .never
+        table.sectionHeaderTopPadding = 0
+        addSubview(table)
+    }
+    required init?(coder: NSCoder) { fatalError("init(coder:) has not been implemented") }
+    override func didMoveToWindow() {
+        super.didMoveToWindow()
+        stopObserving()
+        if window != nil {
+            var ancestor = superview
+            while let view = ancestor {
+                if let scroll = view as? UIScrollView {
+                    scrollHost = scroll
+                    offsetObservation = scroll.observe(\.contentOffset) { [weak self] _, _ in self?.updateViewport() }
+                    boundsObservation = scroll.observe(\.bounds) { [weak self] _, _ in self?.updateViewport() }
+                    break
+                }
+                ancestor = view.superview
+            }
+        }
+        setNeedsLayout()
+    }
+    func stopObserving() {
+        offsetObservation?.invalidate(); offsetObservation = nil
+        boundsObservation?.invalidate(); boundsObservation = nil
+        scrollHost = nil
+    }
+    override func layoutSubviews() { super.layoutSubviews(); updateViewport() }
+    func updateViewport() {
+        guard !table.isScrollEnabled, let scroll = scrollHost, bounds.height > 0 else {
+            if table.frame != bounds { table.frame = bounds }
+            return
+        }
+        let visible = convert(scroll.bounds, from: scroll)
+        let overscan = table.rowHeight * 2
+        let height = min(bounds.height, max(1, scroll.bounds.height + overscan * 2))
+        let top = min(max(0, visible.minY - overscan), max(0, bounds.height - height))
+        let frame = CGRect(x: 0, y: top, width: bounds.width, height: height)
+        if table.frame != frame { table.frame = frame }
+        table.layoutIfNeeded()
+        if table.contentOffset.y != top { table.contentOffset = CGPoint(x: 0, y: top) }
     }
 }

