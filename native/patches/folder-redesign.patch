+/// One native drag surface for list rows and gallery cards. UIKit owns the lift,
+/// insertion gap, drop animation and edge scrolling on both iPhone and iPad.
+struct MusicReorderableCollection<Item: Identifiable, Header: View, Row: View>: UIViewRepresentable where Item.ID: Hashable {
+    var items: [Item]
+    var gallery = false
+    var rowHeight: CGFloat = 80
+    var reorderingEnabled = true
+    var onMove: (Int, Int) -> Void
+    @ViewBuilder var header: () -> Header
+    @ViewBuilder var row: (Item) -> Row
+
+    func makeCoordinator() -> Coordinator { Coordinator(self) }
