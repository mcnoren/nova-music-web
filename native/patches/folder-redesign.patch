+            let keys = parent.items.map { Key.item($0.id) }
+            snapshot.deleteItems([.item(id)])
+            if from != to {
+                if to > from { snapshot.insertItems([.item(id)], afterItem: keys[to]) }
+                else { snapshot.insertItems([.item(id)], beforeItem: keys[to]) }
+            } else if to < keys.count - 1 { snapshot.insertItems([.item(id)], beforeItem: keys[to + 1]) }
+            else { snapshot.appendItems([.item(id)], toSection: 1) }
+            source.apply(snapshot, animatingDifferences: !UIAccessibility.isReduceMotionEnabled)
+            coordinator.drop(drop.dragItem, toItemAt: destination)
+            if from != to { parent.onMove(from, to); UISelectionFeedbackGenerator().selectionChanged() }
+        }
+    }
