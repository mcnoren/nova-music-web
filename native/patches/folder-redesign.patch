+        let coordinator = context.coordinator
+        let layout = UICollectionViewCompositionalLayout { section, environment in
+            let gallery = coordinator.parent.gallery, rowHeight = coordinator.parent.rowHeight
+            let width = environment.container.effectiveContentSize.width
+            let count = section == 0 || !gallery ? 1 : max(2, Int(width / 190))
+            let height: NSCollectionLayoutDimension = section == 0 ? .estimated(200) : .absolute(gallery ? (width - 40 - CGFloat(count - 1) * 16) / CGFloat(count) + 72 : rowHeight)
+            let item = NSCollectionLayoutItem(layoutSize: .init(widthDimension: .fractionalWidth(1 / CGFloat(count)), heightDimension: section == 0 ? .estimated(200) : .fractionalHeight(1)))
+            let group = NSCollectionLayoutGroup.horizontal(layoutSize: .init(widthDimension: .fractionalWidth(1), heightDimension: height), repeatingSubitem: item, count: count)
+            group.interItemSpacing = .fixed(gallery && section != 0 ? 16 : 0)
+            let result = NSCollectionLayoutSection(group: group)
+            result.interGroupSpacing = gallery && section != 0 ? 20 : 2
+            result.contentInsets = .init(top: 0, leading: section == 0 ? 0 : 20, bottom: section == 0 ? 12 : 32, trailing: section == 0 ? 0 : 20)
+            return result
+        }
+        let view = UICollectionView(frame: .zero, collectionViewLayout: layout)
+        view.backgroundColor = UIColor(white: 0.055, alpha: 1)
+        view.alwaysBounceVertical = true; view.dragInteractionEnabled = reorderingEnabled
+        view.reorderingCadence = .immediate
+        view.register(UICollectionViewCell.self, forCellWithReuseIdentifier: "music")
+        context.coordinator.configure(view)
+        return view
+    }
+    func updateUIView(_ view: UICollectionView, context: Context) {
+        let changedLayout = context.coordinator.parent.gallery != gallery
+        context.coordinator.parent = self
+        view.dragInteractionEnabled = reorderingEnabled
+        if changedLayout { view.collectionViewLayout.invalidateLayout() }
+        context.coordinator.update()
+    }
+
+    enum Key: Hashable { case header, item(Item.ID) }
+    final class Coordinator: NSObject, UICollectionViewDragDelegate, UICollectionViewDropDelegate {
+        var parent: MusicReorderableCollection
+        weak var view: UICollectionView?
+        var source: UICollectionViewDiffableDataSource<Int, Key>!
+        var dragging: Item.ID?
+        init(_ parent: MusicReorderableCollection) { self.parent = parent }
+        func configure(_ view: UICollectionView) {
