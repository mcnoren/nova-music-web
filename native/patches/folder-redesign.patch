+            source = UICollectionViewDiffableDataSource<Int, Key>(collectionView: view) { [weak self] view, indexPath, key in
+                let cell = view.dequeueReusableCell(withReuseIdentifier: "music", for: indexPath)
+                guard let self else { return cell }
+                switch key {
+                case .header: cell.contentConfiguration = UIHostingConfiguration { self.parent.header() }.margins(.all, 0)
+                case .item(let id):
+                    if let item = self.parent.items.first(where: { $0.id == id }) {
